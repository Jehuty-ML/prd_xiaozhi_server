# 复制为 .env 后填写（勿提交真实密钥）
# cp .env.example .env

TZ=Asia/Shanghai

# production | development
# production 强制设备鉴权，并开启 control-admin 控制面门禁
XIAOZHI_ENV=production

# MySQL root 密码（全模块 compose 必填，勿用弱口令）
MYSQL_ROOT_PASSWORD=change-me-strong-password

# Redis 密码（可选；留空则无密码，仅建议内网隔离环境）
REDIS_PASSWORD=

# Optional manager-api（也可用 control-admin data/.config.yaml）
# MANAGER_API_URL=http://xiaozhi-esp32-server-web:8002/xiaozhi
# MANAGER_API_SECRET=replace-with-manager-api-secret
