# 复制为 .env 后填写（勿提交真实密钥）
# cp .env.example .env

# 时区
TZ=Asia/Shanghai

# 对话服务运行环境：production | development
# production 会强制开启连接认证，并禁止 query token / 硬编码密钥兜底
XIAOZHI_ENV=production

# MySQL root 密码（全模块 compose 必填，勿用 123456）
MYSQL_ROOT_PASSWORD=change-me-strong-password

# Redis 密码（可选；留空则无密码，仅建议内网隔离环境）
REDIS_PASSWORD=
