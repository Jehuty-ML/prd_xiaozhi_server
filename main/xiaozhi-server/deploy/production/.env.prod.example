# 复制为 .env 后用于生产 compose（勿提交真实密钥）
# cp deploy/production/.env.prod.example .env

TZ=Asia/Shanghai

# 生产 compose 会强制 XIAOZHI_ENV=production；此处再写一次便于本地脚本读取
XIAOZHI_ENV=production

# 全模块必填，请改成强随机密码
MYSQL_ROOT_PASSWORD=change-me-strong-password

# 建议生产设置 Redis 密码，并与 config.overlay.all.yaml 中 registry.redis.password 一致
REDIS_PASSWORD=
